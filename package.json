{
  "name": "crud",
  "version": "1.0.0",
  "description": "A simple CRUD API with in-memory database",
  "main": "dist/server.js",
  "type": "module",
  "scripts": {
    "start": "node dist/server.js",
    "start:dev": "nodemon --watch src --ext ts --exec \"node --loader ts-node/esm\" src/server.ts",
    "start:prod": "npm run build && cross-env NODE_ENV=production node dist/server.js",
    "start:multi": "npm run build && cross-env NODE_ENV=production node dist/cluster.js",
    "build": "tsc",
    "test": "jest",
    "lint": "eslint",
    "dev": "nodemon --watch src --ext ts --exec \"node --loader ts-node/esm\" src/server.ts"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vincapto/node-course.git"
  },
  "author": "Your Name",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/vincapto/node-course/issues"
  },
  "homepage": "https://github.com/vincapto/node-course#readme",
  "dependencies": {
    "dotenv": "^16.4.5",
    "express": "^4.17.1",
    "supertest": "^7.1.0",
    "uuid": "^9.0.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.26.0",
    "@types/express": "^5.0.1",
    "@types/jest": "^29.5.14",
    "@types/node": "^20.11.25",
    "@types/supertest": "^6.0.3",
    "@types/uuid": "^9.0.8",
    "@typescript-eslint/eslint-plugin": "^7.1.1",
    "@typescript-eslint/parser": "^7.1.1",
    "cross-env": "^7.0.3",
    "eslint": "^8.57.1",
    "globals": "^16.0.0",
    "jest": "^29.7.0",
    "nodemon": "^3.1.0",
    "ts-jest": "^29.3.2",
    "ts-loader": "^9.5.1",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.32.0",
    "webpack": "^5.90.3",
    "webpack-cli": "^5.1.4",
    "webpack-node-externals": "^3.0.0"
  },
  "keywords": [
    "CRUD",
    "API",
    "Node.js",
    "Express"
  ]
}
